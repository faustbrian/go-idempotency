      "purpose": "Provide durable ownership, fencing, and bounded result replay for retried HTTP, JSON-RPC, webhook, queue, import, and command workloads.",
      "lifecycle": "stable",
      "kind": "public library",
      "releasable": true,
      "family": "persistence-and-durability",
      "family_label": "Persistence And Durability",
      "family_description": "Durable state, delivery, coordination, recovery, and operational lifecycle.",
      "family_order": 4,
      "cohesion": {
        "family": "persistence-and-durability",
        "secondary_capabilities": [
          "database-and-storage",
          "http-and-service-edge",
          "observability",
          "protocols-and-schemas"
        ],
        "responsibility": "Provide durable operation ownership, fencing, bounded result replay, canonical fingerprints, and explicit transport and workload adapters.",
        "non_goals": [
          "Claim exactly-once execution or own an application's stale-owner side-effect invariant.",
          "Own caller resources, application transactions, transport servers, worker lifecycles, or retry policy."
        ],
        "public_package_identifier": "idempotency",
        "primary_entry_packages": [
          "github.com/faustbrian/go-idempotency"
        ],
        "package_selection": {
          "github.com/faustbrian/go-idempotency": "Use for durable ownership, fencing, typed outcomes, bounded result replay, and the backend-neutral service contract.",
          "github.com/faustbrian/go-idempotency/canonical": "Use for bounded canonical JSON and byte fingerprint construction.",
          "github.com/faustbrian/go-idempotency/idempotencycommand": "Use to apply durable ownership and replay to command and import handlers.",
          "github.com/faustbrian/go-idempotency/idempotencyhttp": "Use to apply Idempotency-Key policy and bounded response replay to HTTP handlers.",
          "github.com/faustbrian/go-idempotency/idempotencylog": "Use for secret-safe structured transition logging through log/slog.",
          "github.com/faustbrian/go-idempotency/idempotencyoutbox": "Use to stage an outbox envelope and idempotency completion in one caller-owned transaction.",
          "github.com/faustbrian/go-idempotency/idempotencyqueue": "Use to apply durable ownership and redelivery deduplication to queue messages.",
          "github.com/faustbrian/go-idempotency/idempotencyrpc": "Use to apply method-aware request ownership and response replay to JSON-RPC handlers.",
          "github.com/faustbrian/go-idempotency/idempotencytelemetry": "Use for bounded OpenTelemetry transition metrics.",
          "github.com/faustbrian/go-idempotency/idempotencytest": "Use in tests for deterministic clocks, tokens, fixtures, and backend conformance.",
          "github.com/faustbrian/go-idempotency/idempotencywebhook": "Use for provider-delivery deduplication after signature verification.",
          "github.com/faustbrian/go-idempotency/memory": "Use for deterministic in-process storage where restart loss is acceptable.",
          "github.com/faustbrian/go-idempotency/postgres": "Use for durable PostgreSQL storage and caller-owned transactional completion.",
          "github.com/faustbrian/go-idempotency/valkey": "Use for durable low-latency ownership in a dedicated Valkey noeviction deployment."
        },
